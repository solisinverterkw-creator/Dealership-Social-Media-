# Database connection URL (MySQL local example or PostgreSQL production example)
# MySQL local: mysql+pymysql://root:@localhost/dealership_dashboard
# PostgreSQL Vercel/Neon: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=mysql+pymysql://root:@localhost/dealership_dashboard

# Flask session secret key (generate a long random string)
FLASK_SECRET_KEY=replace-with-a-very-secure-random-string

# API keys and scrapers configurations (Obtain these from your provider dashboards)
RAPIDAPI_KEY=
SCRAPECREATORS_API_KEY_INSTAGRAM=

# Bright Data API configurations
BRIGHTDATA_API_TOKEN=
